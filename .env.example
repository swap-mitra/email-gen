NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL connection string. Neon (or any Postgres 15+ with pgvector) works —
# get yours from the Neon console; use the pooled endpoint ("-pooler" in the host).
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require
# Better-Auth — random 32+ byte secret, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (sign-in + Gmail export) — create in Google Cloud Console.
# See the README's "Google Cloud Console" setup section.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI — required for P5 (AI + Retrieval)
# All extraction, generation, and embeddings run through OpenRouter's
# OpenAI-compatible API using free-tier (":free") models. Get a key at
# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Optional overrides — defaults below are used if unset. Override these as
# OpenRouter's free-tier catalog rotates: https://openrouter.ai/models?max_price=0
# Extraction model (default: openai/gpt-oss-20b:free)
OPENROUTER_EXTRACTION_MODEL=
# Generation model (default: nvidia/nemotron-3-super-120b-a12b:free)
OPENROUTER_GENERATION_MODEL=
# Embedding model (default: nvidia/llama-nemotron-embed-vl-1b-v2:free — the
# only free embedding model on OpenRouter; multimodal, not text-purpose-built)
OPENROUTER_EMBEDDING_MODEL=

# Ingestion — required for JS-rendered page fallback (P4 browser fallback)
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Storage (optional — for raw HTML artifact persistence)
BLOB_READ_WRITE_TOKEN=

# Inngest async workflows
# Local dev: set INNGEST_DEV=1 and run `npm run inngest` in a separate
# terminal. Leaving INNGEST_DEV unset defaults to cloud mode even
# with blank keys — cloud mode can't invoke functions on localhost, so
# submitted opportunities/drafts will hang at "pending" forever.
# Production (e.g. Vercel): leave INNGEST_DEV unset, set INNGEST_EVENT_KEY and
# INNGEST_SIGNING_KEY from the Inngest dashboard instead.
INNGEST_DEV=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Access requests (landing-page "Request access" section)
# The admin mailbox notified when someone requests access. Must be the email of
# a user who has signed in with Google — their own OAuth token sends the
# notification, so no separate mail provider is needed. Unset disables the
# notification; requests are still recorded.
ACCESS_REQUEST_NOTIFY_EMAIL=
