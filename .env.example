NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/email_gen
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_SIGN_IN_URL=/sign-in
CLERK_SIGN_UP_URL=/sign-up

# AI — required for P5 (AI + Retrieval)
# All extraction, generation, and embeddings run through OpenRouter's
# OpenAI-compatible API using free-tier (":free") models. Get a key at
# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Optional overrides — defaults below are used if unset. Override these as
# OpenRouter's free-tier catalog rotates: https://openrouter.ai/models?max_price=0
# Extraction model (default: openai/gpt-oss-20b:free)
OPENROUTER_EXTRACTION_MODEL=
# Generation model (default: nvidia/nemotron-3-super-120b-a12b:free)
OPENROUTER_GENERATION_MODEL=
# Embedding model (default: nvidia/llama-nemotron-embed-vl-1b-v2:free — the
# only free embedding model on OpenRouter; multimodal, not text-purpose-built)
OPENROUTER_EMBEDDING_MODEL=

# Ingestion — required for JS-rendered page fallback (P4 browser fallback)
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Storage (optional — for raw HTML artifact persistence)
BLOB_READ_WRITE_TOKEN=

# Inngest async workflows
# Production: set INNGEST_EVENT_KEY and INNGEST_SIGNING_KEY from the Inngest dashboard
# Local dev: run `npx inngest-cli@latest dev` — no keys needed
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
